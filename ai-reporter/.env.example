OPENAI_API_KEY=
# Optional. Defaults to https://api.openai.com. Point at the Playwright stub in tests.
OPENAI_BASE_URL=
AI_MODEL=gpt-6.1-sol
PORT=4100
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Must match the backend cookie secret so the sid cookie verifies.
COOKIE_SECRET=dev-cookie-secret
# Number of reverse proxies in front of the process (0/empty = none), so rate limits see the client IP.
TRUST_PROXY=
LOG_LEVEL=info
