# Core API (feed, articles, people, groups, auth...)
# Same-origin /api is proxied to the Express server in vite.config.ts
VITE_API_URL=/api
# AI API (reporter chat + editor drafts)
VITE_AI_API_URL=/ai
# Core talks to Express unless you opt into MSW.
VITE_MOCK_CORE=false
# Reporter/editor stay mocked until that API exists.
VITE_MOCK_AI=true
